{
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "risks", "themes", "findings"],
  "properties": {
    "scope": {
      "type": "string",
      "maxLength": 300,
      "description": "이 PR 이 무엇을 하는지 한 줄. 파일 수 · 증감 줄 수는 코드가 붙이므로 쓰지 않는다."
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 },
      "description": "finding 단위 위험 한 줄씩. finding 이 없으면 빈 배열."
    },
    "themes": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 },
      "description": "변경 전반에 걸친 패턴 1~2개. 없으면 빈 배열."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "category", "body", "rule_ref"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer", "description": "새 파일 기준 줄 번호 (diff 의 + 쪽)" },
          "category": {
            "type": "string",
            "enum": ["correctness", "security", "conventions", "reuse", "perf", "tests"]
          },
          "body": {
            "type": "string",
            "maxLength": 1200,
            "description": "1~3문장. 문제가 되는 코드 조각을 인용하고 무엇을 하면 되는지 적는다."
          },
          "rule_ref": {
            "type": ["string", "null"],
            "description": "근거 룰 파일 · 절 (예: conventions.md §네이밍). 컨벤션 finding 은 필수."
          }
        }
      }
    }
  }
}
